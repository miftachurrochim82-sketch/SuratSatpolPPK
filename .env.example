# Salin file ini menjadi .env lalu sesuaikan nilainya.
#   cp .env.example .env
#
# JANGAN commit file .env — file itu sudah diblokir oleh .gitignore.

# Koneksi PostgreSQL. Wajib ada, aplikasi akan gagal start tanpa ini.
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
